# CloudMachine: the image's metadata stays on local ext4, its bands live on
# Google Drive. /etc/cloudmachine/bundle.env (CM_BUNDLE=<name>.sparsebundle) is
# written by `cloudmachine-agent vm-prepare-bundle`; until then this unit is
# skipped, so Time Machine can create its first, empty image on local disk.
[Unit]
Description=Bind: Time Machine bands on Google Drive
BindsTo=punchfs.service
After=punchfs.service
Before=smbd.service
StartLimitIntervalSec=0
ConditionPathExists=/etc/cloudmachine/bundle.env

[Service]
Type=oneshot
RemainAfterExit=yes
# 27 Nov 2026: one failed bind kept Samba down 13 h. Retry.
Restart=on-failure
RestartSec=15
# 28 Nov 2026: a bind over a dead punchfs mount stays dead; clear it first.
ExecStartPre=-/usr/local/sbin/cm-unmount-stale --bands
# punchfs (Type=simple) is "started" before its mount is up: wait for it.
TimeoutStartSec=150
ExecStartPre=/usr/bin/timeout 120 /bin/sh -c 'until mountpoint -q /srv/tm-punch && [ -d /srv/tm-punch/bands ]; do sleep 1; done'
# Time Machine renames the image when the Mac's name changes (25 Nov 2026); the
# script follows the rename instead of trusting the name stored in bundle.env.
ExecStart=/usr/local/sbin/tm-bundle bind
ExecStop=/usr/local/sbin/tm-bundle unbind

[Install]
WantedBy=multi-user.target
