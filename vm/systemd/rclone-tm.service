# CloudMachine: the Google Drive folder that holds the Time Machine bands.
# /etc/cloudmachine/vm.env (CM_REMOTE) is written by `cloudmachine-agent vm-setup`;
# /etc/cloudmachine/tm-ids.env (TM_UID, TM_GID) by the provisioning script.
[Unit]
Description=rclone: Google Drive -> /srv/tm
After=network-online.target
Wants=network-online.target
Before=smbd.service
ConditionPathExists=/etc/rclone/rclone.conf
ConditionPathExists=/etc/cloudmachine/vm.env

[Service]
# mount2 (go-fuse), not mount: `rclone mount` answers fsync with OK and does
# nothing, so APFS barriers inside the Time Machine image were never durable.
# mount2 passes fsync to the VFS cache item (data + metadata with an up-to-date
# range list); punchfs adds syncfs() for the metadata file (see punchfs.service).
Type=notify
# rclone scans the whole VFS cache (up to 120G) before it mounts; after an
# interrupted upload that takes minutes, and the default 90 s kills it in a loop.
TimeoutStartSec=45min
# 27 Nov 2026: OOM-killed at 1.57 GB (2 GiB VM). Clean kill at 1400M, no throttling.
Environment=GOMEMLIMIT=900MiB
MemoryMax=1400M
OOMPolicy=stop
EnvironmentFile=/etc/cloudmachine/vm.env
EnvironmentFile=/etc/cloudmachine/tm-ids.env
ExecStart=/usr/local/bin/rclone mount2 ${CM_REMOTE} /srv/tm \
  --config /etc/rclone/rclone.conf --allow-other --uid ${TM_UID} --gid ${TM_GID} --umask 002 \
  --vfs-cache-mode full --vfs-cache-max-size 120G --vfs-cache-max-age 9999h --vfs-write-back 600s \
  --cache-dir /var/cache/rclone --dir-cache-time 9999h --poll-interval 0 --attr-timeout 5m \
  --use-mmap --buffer-size 8M --transfers 4 --drive-chunk-size 32M --drive-use-trash=false --drive-stop-on-upload-limit \
  --rc --rc-addr 127.0.0.1:5572 --rc-no-auth --log-file /var/log/rclone-tm.log --log-level INFO
ExecStop=/bin/fusermount3 -uz /srv/tm
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
