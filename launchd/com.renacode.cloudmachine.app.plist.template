<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.renacode.cloudmachine.app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-a</string>
    <string>/Applications/CloudMachine.app</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!--
    Autostart of the UI. Through `open` rather than by running the binary
    directly: launchd would start it outside the Aqua session, and a menu bar
    app has nothing to draw there.

    No KeepAlive - `open` exits immediately after the app starts, so KeepAlive
    would launch it over and over. The user closing the window should stay
    closed, not be an invitation to restart.

    The backups themselves do NOT depend on this app - the gdrive-buffer,
    gdrive-attach and buffer-guard agents do them. This is only a viewer.
  -->
  <key>StandardOutPath</key>
  <string>__CM_LOG_DIR__/launchd-app.out.log</string>
  <key>StandardErrorPath</key>
  <string>__CM_LOG_DIR__/launchd-app.err.log</string>
</dict>
</plist>
