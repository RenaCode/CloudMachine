<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.renacode.cloudmachine.gdrive-attach</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CM_AGENT_BIN__</string>
    <string>attach-image</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!--
    Attaching the image is a one-shot action, so no KeepAlive. Running it
    periodically repairs the case where the image got detached - for example
    after the buffer went down and came back.

    Ordering relative to the buffer needs no external control: `attach-image`
    itself waits until the buffer is up - for how long and for what, see
    `BufferReadiness`. That wait, not this interval, is the main defence
    against the race at startup: the interval only cleans up after the image
    got detached later on.
  -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>StandardOutPath</key>
  <string>__CM_LOG_DIR__/launchd-gdrive-attach.out.log</string>
  <key>StandardErrorPath</key>
  <string>__CM_LOG_DIR__/launchd-gdrive-attach.err.log</string>
</dict>
</plist>
