<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.renacode.cloudmachine.mount-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CM_AGENT_BIN__</string>
    <string>mount-watchdog</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <!--
    KRYTYCZNE: bez tego launchd zabija CALA grupe procesow tego joba, gdy
    tylko glowny proces (cloudmachine-agent) zakonczy dzialanie - a to
    obejmuje TEZ zdaemonizowany `rclone nfsmount --daemon`, ktory ten
    proces uruchamia podczas naprawy. Bez AbandonProcessGroup kazda udana
    naprawa byla natychmiast (w ciagu <1s po zakonczeniu procesu) cofana -
    obserwowane bezposrednio jako "Signal received: terminated" w logu
    rclone DOKLADNIE w tej samej sekundzie co "Naprawa zakonczona
    powodzeniem", w kolko, bez konca. Ten klucz mowi launchd, zeby NIE
    sprzatal procesow potomnych, ktore zyja dalej po zakonczeniu glownego
    procesu joba - dziala identycznie niezaleznie od tego, czy glowny
    proces to bash czy skompilowana binarka Swift.
  -->
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__CM_LOG_DIR__/launchd-mount-watchdog.out.log</string>
  <key>StandardErrorPath</key>
  <string>__CM_LOG_DIR__/launchd-mount-watchdog.err.log</string>
</dict>
</plist>
