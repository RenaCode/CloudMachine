<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.renacode.cloudmachine.buffer-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CM_AGENT_BIN__</string>
    <string>buffer-guard</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!--
    The guard runs indefinitely and goes idle on its own between backups -
    that is why KeepAlive is safe here. If it exited after every finished
    backup, KeepAlive would turn that into a restart loop.
  -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__CM_LOG_DIR__/launchd-buffer-guard.out.log</string>
  <key>StandardErrorPath</key>
  <string>__CM_LOG_DIR__/launchd-buffer-guard.err.log</string>
</dict>
</plist>
