<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.renacode.cloudmachine.gdrive-buffer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CM_AGENT_BIN__</string>
    <string>mount-drive</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!--
    The buffer must always be up - it is what keeps the Time Machine
    destination alive. KeepAlive brings it back after a crash and after the
    Mac wakes up.

    The agent does not retry blindly forever: `mount-drive` first checks
    whether rclone with mount support and FUSE are present, and exits
    immediately with a message if either is missing. Without that, every
    missing component would mean a restart every 30 s and a log growing
    without end.
  -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__CM_LOG_DIR__/launchd-gdrive-buffer.out.log</string>
  <key>StandardErrorPath</key>
  <string>__CM_LOG_DIR__/launchd-gdrive-buffer.err.log</string>
</dict>
</plist>
