<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.renacode.cloudmachine.vm-start</string>
  <!--
    Starts the machine at login and stays alive (`vm-hold`): launchd's SIGTERM
    at logout or shutdown becomes a clean `limactl stop` of the machine, which
    otherwise dies hard with the Mac. ExitTimeOut is how long launchd waits
    before SIGKILL; it must exceed VMHold.stopTimeout (a test keeps them
    together). limactl comes from Homebrew, found through PATH below.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>__CM_AGENT_BIN__</string>
    <string>vm-hold</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ExitTimeOut</key>
  <integer>120</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__CM_LOG_DIR__/launchd-vm-start.out.log</string>
  <key>StandardErrorPath</key>
  <string>__CM_LOG_DIR__/launchd-vm-start.err.log</string>
</dict>
</plist>
