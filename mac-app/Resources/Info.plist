<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>CloudMachine</string>
  <key>CFBundleDisplayName</key>
  <string>CloudMachine</string>
  <key>CFBundleIdentifier</key>
  <string>com.renacode.cloudmachine</string>
  <key>CFBundleVersion</key>
  <string>__CM_BUILD__</string>
  <key>CFBundleShortVersionString</key>
  <string>__CM_VERSION__</string>
  <!--
    The version number and the build number are not enough to identify WHAT
    exactly is running: VERSION stays the same for months, and the build number
    (commit count) repeats across branches. The commit SHA identifies it
    unambiguously, and CMGitDirty tells whether the binary contains code that
    is not in any commit.
  -->
  <key>CMGitCommit</key>
  <string>__CM_COMMIT__</string>
  <key>CMGitDirty</key>
  <string>__CM_DIRTY__</string>
  <!--
    The languages L10n translates into (L10n.Language). Declaring them makes
    macOS use the same language for its own parts of the app, and mirror the
    window for Arabic and Hebrew.
  -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>ar</string>
    <string>da</string>
    <string>de</string>
    <string>en</string>
    <string>es</string>
    <string>fi</string>
    <string>fr</string>
    <string>he</string>
    <string>it</string>
    <string>ja</string>
    <string>ko</string>
    <string>ms</string>
    <string>nb</string>
    <string>nl</string>
    <string>pl</string>
    <string>pt-BR</string>
    <string>ru</string>
    <string>sv</string>
    <string>th</string>
    <string>tr</string>
    <string>zh-Hans</string>
    <string>zh-Hant</string>
  </array>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleExecutable</key>
  <string>CloudMachine</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSUIElement</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright (c) 2026 Marcin Bęczyński. MIT License.</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.utilities</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
</dict>
</plist>
